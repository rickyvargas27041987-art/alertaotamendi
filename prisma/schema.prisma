generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Report {
  id          Int      @id @default(autoincrement())
  category    String
  description String
  status      String   @default("pendiente")
  latitude    Float?
  longitude   Float?
  imageUrl    String?
  videoUrl    String?
  audioUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // OPERACIÓN DEL CENTRO DE MONITOREO
  assignedToId   Int?
  assignedAt     DateTime?
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  assignedTo     MonitoringUser? @relation("AssignedReports", fields: [assignedToId], references: [id], onDelete: SetNull)

  // JURISDICCIÓN (resuelta automáticamente desde la ubicación)
  province String?
  district String?
  locality String?

  // ANALISIS DE INTELIGENCIA ARTIFICIAL
  aiAnalyzed     Boolean   @default(false)
  aiCategory     String?
  aiPriority     String?
  aiSummary      String?
  aiConfidence   Float?
  aiPossibleSpam Boolean?
  aiReason       String?
  aiAnalyzedAt   DateTime?

  // RED OPERATIVA
  // La base PostgreSQL limita a un incidente principal por reporte mediante
  // un índice único parcial. Prisma lo modela como lista porque no representa
  // índices únicos parciales directamente.
  operationalIncidents OperationalIncident[] @relation("IncidentSourceReport")

  @@index([assignedToId])
  @@index([status, createdAt])
  @@index([province, district, locality])
}

model VehicleWatch {
  id Int @id @default(autoincrement())

  // Reporte donde apareció originalmente el vehículo
  sourceReportId Int

  // Foto de referencia
  imageUrl String

  // Datos identificados por IA
  plate       String?
  make        String?
  model       String?
  color       String?
  vehicleType String?
  distinctive String?

  // Resumen visual generado por IA
  visualSummary String?

  // Seguimiento
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sourceReportId])
  @@index([active])
  @@index([plate])
}

model VehicleMatch {
  id Int @id @default(autoincrement())

  // Vehículo que ya estaba en seguimiento
  vehicleWatchId Int

  // Reporte nuevo donde apareció la posible coincidencia
  reportId Int

  // Reporte original que inició el seguimiento
  sourceReportId Int

  // Foto del nuevo reporte
  imageUrl String

  // Resultado de la comparación IA
  confidence Float

  // Explicación breve de por qué puede ser el mismo vehículo
  reason String

  // Datos observados en la nueva imagen
  detectedPlate       String?
  detectedMake        String?
  detectedModel       String?
  detectedColor       String?
  detectedVehicleType String?
  detectedDistinctive String?
  visualSummary       String?

  // Estado de revisión por el operador
  status String @default("pendiente")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([vehicleWatchId, reportId])
  @@index([vehicleWatchId])
  @@index([reportId])
  @@index([sourceReportId])
  @@index([status])
  @@index([confidence])
}

model TrackingTarget {
  id Int @id @default(autoincrement())

  type        String
  title       String
  reason      String
  description String?
  imageUrl    String?

  province String?
  district String?
  locality String?

  active        Boolean   @default(true)
  createdById   Int?
  createdByName String
  closedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  personAge      String?
  personFeatures String?

  vehiclePlate String?
  vehicleMake  String?
  vehicleModel String?
  vehicleColor String?
  vehicleType  String?
  distinctive  String?

  @@index([type, active])
  @@index([province, district, locality])
  @@index([vehiclePlate])
  @@index([createdAt])
}

model TrackingMatch {
  id Int @id @default(autoincrement())

  trackingTargetId Int
  reportId         Int

  confidence Float
  reason     String
  status     String @default("pendiente")

  reportImageUrl String?
  reportCategory String
  reportProvince String?
  reportDistrict String?
  reportLocality String?

  reviewedById   Int?
  reviewedByName String?
  reviewedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([trackingTargetId, reportId])
  @@index([trackingTargetId, status])
  @@index([reportId])
  @@index([confidence])
  @@index([createdAt])
}

model PersonPatternAlert {
  id Int @id @default(autoincrement())

  // Tipo de alerta preventiva agrupada
  category String @default("Persona sospechosa")

  // Reporte que hizo alcanzar o superar el umbral de 3 coincidencias
  triggerReportId Int

  // Todos los reportes que la IA consideró posiblemente relacionados
  reportIds Int[] @default([])

  // Cantidad de reportes incluidos actualmente en el patrón
  reportCount Int @default(3)

  // Zona aproximada del patrón
  centerLatitude  Float?
  centerLongitude Float?

  // Parámetros usados para detectar el patrón
  radiusKm          Float @default(1)
  timeWindowMinutes Int   @default(30)

  // Resumen para el operador
  summary String
  reason  String?

  // Confianza general del análisis, entre 0 y 1
  confidence Float?

  // Se completa una sola vez al emitir el aviso preventivo público
  notificationSentAt DateTime?

  // Estado de revisión en el Centro de Monitoreo
  status String @default("pendiente")

  // Último reporte incorporado al patrón
  lastReportAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([triggerReportId])
  @@index([category])
  @@index([reportCount])
  @@index([status])
  @@index([lastReportAt])
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  endpoint  String   @unique
  p256dh    String
  auth      String
  latitude  Float
  longitude Float
  enabled   Boolean  @default(true)

  // UBICACIÓN ADMINISTRATIVA DEL USUARIO DE LA APP
  province String?
  district String?
  locality String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
  @@index([province, district, locality])
  @@index([createdAt])
}

// Instalación anónima de la app pública. Permite contar usuarios sin guardar
// nombre, teléfono ni otra información personal.
model AppInstallation {
  id             Int      @id @default(autoincrement())
  installationId String   @unique
  platform       String?
  province       String?
  district       String?
  locality       String?
  createdAt      DateTime @default(now())
  lastSeenAt     DateTime @updatedAt

  @@index([province, district, locality])
  @@index([createdAt])
  @@index([lastSeenAt])
}

model MonitoringUser {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  name         String
  passwordHash String
  role         String    @default("OPERATOR")
  organizationType String @default("MUNICIPAL")
  active       Boolean   @default(true)
  lastLoginAt  DateTime?

  // SUSCRIPCIÓN / ACCESO COMERCIAL AL CENTRO DE MONITOREO
  billingEmail          String?
  customMonthlyCents    Int?
  customAnnualCents     Int?
  customCheckoutState   String?
  customCheckoutCents   Int?
  customCheckoutPlan    String?
  customCheckoutUrl     String?
  subscriptionPlan      String    @default("COURTESY")
  subscriptionStatus    String    @default("ACTIVE")
  subscriptionStartedAt DateTime?
  subscriptionEndsAt    DateTime?
  subscriptionAutoRenew Boolean   @default(false)

  // Mercado Pago (nunca guardar el Access Token en la base)
  mpPreapprovalId String?   @unique
  mpPlanId        String?
  mpStatus        String?
  mpLastPaymentAt DateTime?
  mpLastPaymentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  zones                 UserZone[]
  sessions              MonitorSession[]
  auditLogs             AuditLog[]
  assignedReports       Report[]               @relation("AssignedReports")
  operationalCodeConfig OperationalCodeConfig?

  // RED OPERATIVA MULTI-ORGANISMO
  operationalMemberships          OperationalOrganizationMember[] @relation("OrganizationMemberUser")
  coordinatedOperationalIncidents OperationalIncident[]           @relation("IncidentCoordinatorUser")
  requestedOperationalResponses   OperationalIncidentResponse[]   @relation("IncidentResponseRequesterUser")
  operationalIncidentEvents       OperationalIncidentEvent[]      @relation("IncidentEventActorUser")

  @@index([active])
  @@index([role])
  @@index([organizationType])
  @@index([subscriptionPlan])
  @@index([subscriptionStatus])
  @@index([subscriptionEndsAt])
}

// Código temporal que cada Centro comparte con personal operativo autorizado.
// El código visible se deriva de forma segura y nunca se guarda en texto plano.
model OperationalCodeConfig {
  id                Int                   @id @default(autoincrement())
  centerKey         String                @unique
  ownerUserId       Int?                  @unique
  revision          Int                   @default(0)
  rotationStartedAt DateTime              @default(now())
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  ownerUser         MonitoringUser?       @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  sessions          OperationalSession[]
  auditLogs         OperationalAuditLog[]

  @@index([updatedAt])
}

model OperationalSession {
  id                Int                           @id @default(autoincrement())
  configId          Int
  tokenHash         String                        @unique
  officerName       String
  agency            String
  serviceType       String
  revision          Int
  expiresAt         DateTime
  revokedAt         DateTime?
  lastAccessAt      DateTime                      @default(now())
  createdAt         DateTime                      @default(now())
  config            OperationalCodeConfig         @relation(fields: [configId], references: [id], onDelete: Cascade)
  auditLogs         OperationalAuditLog[]
  pushSubscriptions OperationalPushSubscription[]
  fcmDevices        OperationalFcmDevice[]

  @@index([configId, expiresAt])
  @@index([revokedAt])
}

// Dispositivos del personal operativo que aceptó recibir avisos dirigidos.
model OperationalPushSubscription {
  id        Int                @id @default(autoincrement())
  sessionId Int
  endpoint  String             @unique
  p256dh    String
  auth      String
  enabled   Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  session   OperationalSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, enabled])
}

model OperationalFcmDevice {
  id        Int                @id @default(autoincrement())
  sessionId Int
  token     String             @unique
  enabled   Boolean            @default(true)
  lastSeenAt DateTime          @default(now())
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  session   OperationalSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, enabled])
  @@index([lastSeenAt])
}

model OperationalResponseState {
  id          Int      @id @default(autoincrement())
  reportId    Int
  serviceType String

  status      String   @default("pending")
  officerName String
  agency      String

  receivedAt  DateTime?
  enRouteAt   DateTime?
  onSceneAt   DateTime?
  finishedAt  DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([reportId, serviceType])
  @@index([reportId])
  @@index([serviceType, status])
  @@index([updatedAt])
}

model OperationalAuditLog {
  id        Int                   @id @default(autoincrement())
  configId  Int
  sessionId Int?
  actorName String
  action    String
  details   String?
  reportId  Int?
  createdAt DateTime              @default(now())
  config    OperationalCodeConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  session   OperationalSession?   @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([configId, createdAt])
  @@index([sessionId])
  @@index([reportId])
}

model UserZone {
  id       Int            @id @default(autoincrement())
  userId   Int
  province String
  district String
  locality String?
  user     MonitoringUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([province, district, locality])
}

model MonitorSession {
  id        Int            @id @default(autoincrement())
  userId    Int
  tokenHash String         @unique
  expiresAt DateTime
  createdAt DateTime       @default(now())
  user      MonitoringUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id            Int             @id @default(autoincrement())
  userId        Int?
  actorName     String
  actorUsername String
  action        String
  details       String?
  reportId      Int?
  createdAt     DateTime        @default(now())
  user          MonitoringUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([reportId])
  @@index([createdAt])
}

model FcmDevice {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  latitude  Float
  longitude Float
  enabled   Boolean  @default(true)

  // UBICACIÓN ADMINISTRATIVA DEL USUARIO DE LA APP
  province String?
  district String?
  locality String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled])
  @@index([province, district, locality])
  @@index([createdAt])
}

// =========================================================
// ALERTAS METEOROLÓGICAS OFICIALES
// =========================================================
//
// Guarda cada mensaje meteorológico recibido desde una fuente oficial
// (por ejemplo SMN/CAP), incluyendo su vigencia, severidad, áreas
// afectadas y huella de contenido para detectar cambios reales.
//
model WeatherAlert {
  id         Int    @id @default(autoincrement())
  source     String @default("SMN")
  externalId String @unique

  // Tipo de producto: ALERTA, ADVERTENCIA, ACP, etc.
  kind String

  // Metadatos del mensaje oficial / CAP
  sender        String?
  messageStatus String?
  messageType   String?
  scope         String?
  references    String[] @default([])
  incidents     String[] @default([])

  // Información meteorológica principal
  category    String?
  event       String
  urgency     String?
  severity    String?
  certainty   String?
  headline    String?
  description String?
  instruction String?
  sourceWeb   String?

  // Vigencia oficial
  sentAt      DateTime?
  effectiveAt DateTime?
  onsetAt     DateTime?
  expiresAt   DateTime?

  // Cobertura geográfica.
  // "areas" puede contener uno o varios polígonos/círculos/geocódigos
  // tal como llegan desde la fuente oficial.
  areaDescription String?
  areas           Json?

  // Nombres administrativos derivados para facilitar diagnóstico,
  // visualización y filtros complementarios.
  provinces  String[] @default([])
  districts  String[] @default([])
  localities String[] @default([])

  // Huella del contenido normalizado. Si el mismo externalId cambia,
  // una huella nueva permite tratarlo como actualización.
  fingerprint String

  // Estado interno. Una alerta cancelada o vencida deja de generar envíos.
  active Boolean @default(true)

  // Copia del mensaje original para auditoría y futuras mejoras del parser.
  rawPayload Json?

  firstSeenAt    DateTime  @default(now())
  lastSeenAt     DateTime  @updatedAt
  lastNotifiedAt DateTime?

  deliveries WeatherNotificationDelivery[]

  @@index([source, kind])
  @@index([active, expiresAt])
  @@index([severity, active])
  @@index([sentAt])
  @@index([fingerprint])
}

// Registro por dispositivo/canal.
//
// La clave única evita notificar dos veces el mismo contenido al mismo
// destino. Si una alerta oficial se actualiza y cambia su fingerprint,
// puede enviarse una nueva notificación de actualización.
model WeatherNotificationDelivery {
  id             Int          @id @default(autoincrement())
  weatherAlertId Int
  weatherAlert   WeatherAlert @relation(fields: [weatherAlertId], references: [id], onDelete: Cascade)

  // WEB_PUSH o FCM
  channel String

  // ID numérico de PushSubscription o FcmDevice.
  // Se interpreta junto con "channel".
  targetId Int

  fingerprint String

  // pending, sent, failed, expired
  status   String @default("pending")
  attempts Int    @default(0)

  lastAttemptAt DateTime?
  sentAt        DateTime?
  lastError     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([weatherAlertId, channel, targetId, fingerprint])
  @@index([status, lastAttemptAt])
  @@index([weatherAlertId, status])
  @@index([channel, targetId])
}

// Historial de cada consulta a las fuentes meteorológicas.
// Sirve para saber si el SMN respondió, cuánto tiempo hace que no hay
// una sincronización correcta y cuántos registros fueron procesados.
model WeatherSyncRun {
  id Int @id @default(autoincrement())

  source String @default("SMN")
  feed   String

  status     String @default("running")
  httpStatus Int?

  itemsReceived  Int @default(0)
  itemsProcessed Int @default(0)
  itemsCreated   Int @default(0)
  itemsUpdated   Int @default(0)

  notificationsTargeted Int @default(0)
  notificationsSent     Int @default(0)
  notificationsFailed   Int @default(0)

  error String?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([source, feed, startedAt])
  @@index([status, startedAt])
}

// Estado persistente de cada feed oficial.
// Permite usar ETag/Last-Modified, registrar fallas consecutivas y
// distinguir "no hay alertas" de "la fuente no respondió".
model WeatherSourceState {
  id Int @id @default(autoincrement())

  sourceKey String @unique
  source    String @default("SMN")
  feed      String
  endpoint  String

  etag         String?
  lastModified String?

  lastAttemptAt DateTime?
  lastSuccessAt DateTime?

  consecutiveFailures Int @default(0)
  lastHttpStatus      Int?
  lastError           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([source, feed])
  @@index([lastSuccessAt])
}

// =========================================================
// RED OPERATIVA MULTI-ORGANISMO
// =========================================================
//
// Esta capa convive con el Acceso Operativo actual durante la transición.
// No reemplaza todavía OperationalSession ni OperationalResponseState.
// =========================================================

model OperationalNetwork {
  id       Int     @id @default(autoincrement())
  name     String
  province String
  district String
  active   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizations OperationalOrganization[]
  incidents     OperationalIncident[]

  @@unique([province, district], map: "OperationalNetwork_province_district_key")
  @@index([active])
}

model OperationalOrganization {
  id        Int    @id @default(autoincrement())
  networkId Int
  name      String
  shortName String?
  type      String
  active    Boolean @default(true)

  // Un Centro de Monitoreo o una institución autorizada puede asumir
  // coordinación general del incidente sin controlar las acciones de
  // los demás organismos.
  canCoordinate Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  network OperationalNetwork @relation(fields: [networkId], references: [id], onDelete: Cascade)

  zones   OperationalOrganizationZone[]
  members OperationalOrganizationMember[]

  coordinatedIncidents OperationalIncident[] @relation("IncidentCoordinatorOrganization")

  responses          OperationalIncidentResponse[] @relation("IncidentResponseOrganization")
  requestedResponses OperationalIncidentResponse[] @relation("IncidentResponseRequesterOrganization")

  incidentEvents OperationalIncidentEvent[]

  @@unique([networkId, name], map: "OperationalOrganization_networkId_name_key")
  @@index([networkId, type, active])
}

model OperationalOrganizationZone {
  id             Int @id @default(autoincrement())
  organizationId Int

  province String
  district String
  locality String?

  createdAt DateTime @default(now())

  organization OperationalOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // La unicidad con locality NULL se encuentra protegida en PostgreSQL
  // mediante un índice de expresión COALESCE creado por el script SQL.
  @@index([organizationId])
  @@index([province, district, locality])
}

model OperationalOrganizationMember {
  id             Int @id @default(autoincrement())
  organizationId Int
  userId         Int

  // ADMIN, COORDINATOR, DISPATCHER, OPERATOR o VIEWER.
  role String @default("OPERATOR")

  active    Boolean @default(true)
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization OperationalOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         MonitoringUser          @relation("OrganizationMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId], map: "OperationalOrganizationMember_organizationId_userId_key")
  @@index([userId, active])
  @@index([organizationId, active])
}

model OperationalIncident {
  id        Int @id @default(autoincrement())
  networkId Int

  // REPORT, WEATHER o MANUAL.
  source    String @default("REPORT")
  reportId  Int?
  sourceRef String?

  title       String
  category    String
  priority    String @default("normal")
  status      String @default("NEW")
  description String?

  latitude  Float?
  longitude Float?
  province  String?
  district  String?
  locality  String?

  coordinatorOrganizationId Int?
  coordinatorUserId         Int?

  openedAt     DateTime  @default(now())
  controlledAt DateTime?
  resolvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  network OperationalNetwork @relation(fields: [networkId], references: [id], onDelete: Cascade)

  // PostgreSQL aplica un índice único parcial sobre reportId cuando no es NULL.
  // Prisma no expresa ese tipo de índice, por eso la relación se mantiene
  // como relación normal sin @unique en este archivo.
  report Report? @relation("IncidentSourceReport", fields: [reportId], references: [id], onDelete: SetNull)

  coordinatorOrganization OperationalOrganization? @relation("IncidentCoordinatorOrganization", fields: [coordinatorOrganizationId], references: [id], onDelete: SetNull)

  coordinatorUser MonitoringUser? @relation("IncidentCoordinatorUser", fields: [coordinatorUserId], references: [id], onDelete: SetNull)

  responses OperationalIncidentResponse[]
  events    OperationalIncidentEvent[]

  @@index([networkId, status, priority])
  @@index([province, district, locality])
  @@index([openedAt])
  @@index([reportId])
  @@index([source, sourceRef])
}

model OperationalIncidentResponse {
  id             Int @id @default(autoincrement())
  incidentId     Int
  organizationId Int

  // RECOMMENDED, REQUESTED, RECEIVED, DISPATCHED, EN_ROUTE,
  // ON_SCENE, FINISHED, UNAVAILABLE, NOT_REQUIRED o CANCELLED.
  status String @default("REQUESTED")

  // AUTO, RECOMMENDED, MANUAL o SUPPORT_REQUEST.
  routingMode String @default("MANUAL")

  requestPriority String @default("NORMAL")
  requestReason   String?

  requestedByOrganizationId Int?
  requestedByUserId         Int?

  resourceLabel   String?
  responsibleName String?

  requestedAt  DateTime  @default(now())
  receivedAt   DateTime?
  dispatchedAt DateTime?
  enRouteAt    DateTime?
  onSceneAt    DateTime?
  finishedAt   DateTime?
  declinedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  incident OperationalIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  organization OperationalOrganization @relation("IncidentResponseOrganization", fields: [organizationId], references: [id], onDelete: Cascade)

  requestedByOrganization OperationalOrganization? @relation("IncidentResponseRequesterOrganization", fields: [requestedByOrganizationId], references: [id], onDelete: SetNull)

  requestedByUser MonitoringUser? @relation("IncidentResponseRequesterUser", fields: [requestedByUserId], references: [id], onDelete: SetNull)

  @@unique([incidentId, organizationId], map: "OperationalIncidentResponse_incidentId_organizationId_key")
  @@index([organizationId, status])
  @@index([incidentId, status])
  @@index([updatedAt])
}

model OperationalIncidentEvent {
  id         Int @id @default(autoincrement())
  incidentId Int

  organizationId Int?
  actorUserId     Int?

  actorName String
  actorRole String?

  // INCIDENT_CREATED, COORDINATION_TAKEN, ORGANIZATION_REQUESTED,
  // RESPONSE_RECEIVED, RESOURCE_DISPATCHED, EN_ROUTE, ON_SCENE,
  // RESPONSE_FINISHED, SUPPORT_REQUESTED, NOTE_ADDED,
  // INCIDENT_CONTROLLED o INCIDENT_RESOLVED.
  type String

  message  String?
  metadata Json?

  createdAt DateTime @default(now())

  incident OperationalIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  organization OperationalOrganization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  actorUser MonitoringUser? @relation("IncidentEventActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([incidentId, createdAt])
  @@index([organizationId, createdAt])
  @@index([type])
}


// Límites compartidos entre instancias de Vercel. La clave se guarda como hash,
// nunca como dirección IP en texto plano.
model RequestRateLimit {
  key         String   @id
  count       Int      @default(1)
  windowStart DateTime @default(now())
  expiresAt   DateTime
  updatedAt   DateTime @updatedAt

  @@index([expiresAt])
